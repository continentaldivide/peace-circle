# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put real keys here.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Local values come from `supabase status`; hosted ones from the project's API
# settings. Point these at the LOCAL stack for day-to-day development: magic
# links then land in Mailpit (http://127.0.0.1:54324) with no rate limit, and
# you are not developing against the real database.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS, so it must NEVER carry a NEXT_PUBLIC_ prefix —
# that would inline it into the browser bundle at build time and hand every
# visitor full access to the database.
SUPABASE_SECRET_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Only for mail the APP composes — currently the interest-form notification to
# admins. Magic links and invites are sent by Supabase Auth through the SMTP
# provider configured in the project dashboard, not through these.
#
# Leave RESEND_API_KEY unset locally: lib/email.ts then logs messages to the
# console instead of sending them, so no account or network is needed.
RESEND_API_KEY=re_...

# Must be on a domain verified in Resend. The sending subdomain is separate
# from the domain's normal mail, so transactional sending cannot affect the
# reputation of personal email on the root domain.
#
# If unset, lib/email.ts falls back to Resend's shared onboarding@resend.dev,
# which needs no domain but only delivers to your own Resend account address.
EMAIL_FROM=Peace Circle <hello@send.andrewsmith.org>

# Who gets told about a new inquiry. Comma-separated, and deliberately in env
# rather than the database so it works before any admin profile exists.
ADMIN_NOTIFY_EMAILS=someone@example.org,someone-else@example.org
